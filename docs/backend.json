{
  "entities": {
    "Company": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Company",
      "type": "object",
      "description": "Representa una organización o empresa cliente de la plataforma SaaS.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "taxId": { "type": "string", "description": "RUC o DNI corporativo." },
        "logoUrl": { "type": "string", "description": "URL del logotipo principal." },
        "headerUrl": { "type": "string", "description": "URL del imagen de cabecera para documentos." },
        "footerUrl": { "type": "string", "description": "URL de la imagen de pie de página para documentos." },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "website": { "type": "string", "description": "Sitio web oficial de la empresa." },
        "primaryColor": { "type": "string", "description": "Color principal en formato HEX" },
        "accentColor": { "type": "string", "description": "Color de acento en formato HEX" },
        "footerBgColor": { "type": "string", "description": "Color de fondo del pie de página en formato HEX o RGB" },
        "themeMode": { "type": "string", "enum": ["light", "dark"] },
        "status": { "type": "string", "enum": ["Active", "Pending", "Suspended"] },
        "plan": { "type": "string", "enum": ["Demo", "Básico", "Profesional", "Empresarial"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "taxId"]
    },
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Perfil de usuario vinculado a una empresa específica.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "roleId": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Inactive", "Pending"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "companyId", "name", "email", "roleId"]
    },
    "Client": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Client",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientType": { "type": "string", "enum": ["Empresa", "Persona"] },
        "name": { "type": "string" },
        "taxId": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" }
      },
      "required": ["id", "companyId", "clientType", "name", "taxId"]
    },
    "ClientEquipment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ClientEquipment",
      "type": "object",
      "description": "Inventario detallado de equipos propiedad del cliente (Hoja de Vida).",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "type": { "type": "string", "enum": ["PQS", "CO2", "Agua", "Acetato de Potasio", "Otros"] },
        "serialNumber": { "type": "string" },
        "brand": { "type": "string" },
        "capacity": { "type": "string" },
        "location": { "type": "string", "description": "Ubicación física dentro de las instalaciones del cliente." },
        "manufacturingYear": { "type": "integer" },
        "lastServiceDate": { "type": "string", "format": "date" },
        "nextServiceDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Operativo", "Mantenimiento", "Vencido", "Baja"] }
      },
      "required": ["id", "companyId", "clientId", "serialNumber"]
    },
    "Quotation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Quotation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "quotationNumber": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "quantity": { "type": "number" },
              "unitPrice": { "type": "number" },
              "total": { "type": "number" }
            }
          }
        },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "total": { "type": "number" },
        "conditions": { "type": "string" },
        "status": { "type": "string", "enum": ["Borrador", "Enviado", "Aceptado", "Rechazado", "Convertido"] }
      }
    },
    "ServiceOrder": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ServiceOrder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "clientId": { "type": "string" },
        "quotationId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Pendiente", "Programado", "En Ejecución", "Finalizado", "Cancelado"] },
        "technicianId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "CatalogItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CatalogItem",
      "type": "object",
      "description": "Producto o servicio del catálogo maestro para cotizaciones.",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "category": { "type": "string", "enum": ["Extintor", "Gabinete", "Accesorios"] },
        "operationType": { "type": "string", "enum": ["Venta", "Recarga", "Mantenimiento", "Inspección", "Alquiler"] },
        "description": { "type": "string" },
        "extinguishingAgent": { "type": "string" },
        "capacity": { "type": "string" },
        "buyPrice": { "type": "number" },
        "sellPrice": { "type": "number" },
        "currentStock": { "type": "integer" },
        "maxDiscount": { "type": "number" },
        "frequencyMonths": { "type": "integer" },
        "status": { "type": "string" }
      },
      "required": ["id", "companyId", "category", "operationType", "description", "sellPrice"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "companies": {
      "schema": { "$ref": "#/backend/entities/Company" },
      "description": "Registro central de empresas."
    },
    "company_users": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Usuarios de la plataforma."
    },
    "clients": {
      "schema": { "$ref": "#/backend/entities/Client" },
      "description": "Clientes por empresa."
    },
    "client_equipment": {
      "schema": { "$ref": "#/backend/entities/ClientEquipment" },
      "description": "Inventario de activos de clientes para mantenimiento."
    },
    "quotations": {
      "schema": { "$ref": "#/backend/entities/Quotation" },
      "description": "Cotizaciones generadas por empresa."
    },
    "service_orders": {
      "schema": { "$ref": "#/backend/entities/ServiceOrder" },
      "description": "Órdenes de servicio activas."
    },
    "all_extinguishers": {
      "schema": { "$ref": "#/backend/entities/CatalogItem" },
      "description": "Catálogo maestro de productos y servicios."
    }
  }
}
