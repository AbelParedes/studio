
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile within the system, including their role and permissions.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "roleId": { "type": "string", "description": "ID del rol asignado desde la colección de roles." },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "roleId"]
    },
    "RoleDefinition": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RoleDefinition",
      "type": "object",
      "description": "Define un rol del sistema con sus respectivos permisos.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "permissions": {
          "type": "object",
          "properties": {
            "manage_users": { "type": "boolean" },
            "manage_inventory": { "type": "boolean" },
            "view_reports": { "type": "boolean" },
            "manage_clients": { "type": "boolean" },
            "field_operations": { "type": "boolean" }
          }
        },
        "color": { "type": "string" }
      },
      "required": ["id", "title", "permissions"]
    },
    "Client": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Client",
      "type": "object",
      "description": "Expediente detallado de cliente para Servifumiga Pro.",
      "properties": {
        "id": { "type": "string" },
        "clientType": { "type": "string", "enum": ["Empresa", "Persona"] },
        "name": { "type": "string" },
        "legalName": { "type": "string" },
        "taxId": { "type": "string", "description": "RUC para empresas, DNI para personas." },
        "industry": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "address": { "type": "string" },
        "contactPerson": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "position": { "type": "string" },
            "phone": { "type": "string" }
          }
        },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "clientType", "name", "taxId", "email", "address"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "company_users": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Perfiles de usuarios del sistema."
    },
    "system_roles": {
      "schema": { "$ref": "#/backend/entities/RoleDefinition" },
      "description": "Definiciones de roles y permisos del sistema."
    },
    "clients": {
      "schema": { "$ref": "#/backend/entities/Client" },
      "description": "Colección de clientes."
    }
  }
}
