
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user profile within the system, including their role and permissions.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { 
          "type": "string", 
          "enum": ["Administrator", "Technician", "Client", "Support"] 
        },
        "status": { "type": "string", "enum": ["Active", "Inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Client": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Client",
      "type": "object",
      "description": "Expediente detallado de cliente para Servifumiga Pro.",
      "properties": {
        "id": { "type": "string" },
        "clientType": { "type": "string", "enum": ["Empresa", "Persona"] },
        "name": { "type": "string" },
        "legalName": { "type": "string" },
        "taxId": { "type": "string", "description": "RUC para empresas, DNI para personas." },
        "industry": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "address": { "type": "string" },
        "contactPerson": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "position": { "type": "string" },
            "phone": { "type": "string" }
          }
        },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "clientType", "name", "taxId", "email", "address"]
    },
    "Extinguisher": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Extinguisher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "serialNumber": { "type": "string" },
        "type": { "type": "string" },
        "size": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string" },
        "lastService": { "type": "string" },
        "nextDue": { "type": "string" }
      }
    },
    "FumigationService": {
      "title": "FumigationService",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "type": { "type": "string" },
        "areas": { "type": "string" },
        "chemicals": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["Programado", "En Proceso", "Completado"] }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "company_users": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Perfiles de usuarios del sistema."
    },
    "clients": {
      "schema": { "$ref": "#/backend/entities/Client" },
      "description": "Colección de clientes."
    },
    "all_extinguishers": {
      "schema": { "$ref": "#/backend/entities/Extinguisher" },
      "description": "Inventario global de extintores."
    },
    "fumigation_services": {
      "schema": { "$ref": "#/backend/entities/FumigationService" },
      "description": "Registros de servicios de fumigación."
    }
  }
}
