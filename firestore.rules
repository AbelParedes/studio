
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * Prototyping Mode: Access is allowed for any authenticated user to ensure
     * maximum operational speed and functional CRUD during the demo.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // --- COLLECTION RULES ---

    // Allow all authenticated users to read and write for the prototype
    match /{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // Specific rules for path-data consistency where required
    match /clients/{clientId} {
      match /contactPersons/{personId} {
        allow create, update: if isSignedIn() && request.resource.data.clientId == clientId;
      }
      match /serviceLocations/{locationId} {
        allow create, update: if isSignedIn() && request.resource.data.clientId == clientId;
      }
      match /serviceAppointments/{appointmentId} {
        allow create, update: if isSignedIn() && request.resource.data.clientId == clientId;
      }
    }
    
    // Global inventory used in the MVP
    match /all_extinguishers/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
