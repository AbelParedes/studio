
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    match /certificates/{id} {
      allow read, write: if isSignedIn();
    }

    match /clients/{clientId} {
      match /contactPersons/{personId} {
        allow create, update: if isSignedIn() && request.resource.data.clientId == clientId;
      }
      match /serviceLocations/{locationId} {
        allow create, update: if isSignedIn() && request.resource.data.clientId == clientId;
      }
      match /serviceAppointments/{appointmentId} {
        allow create, update: if isSignedIn() && request.resource.data.clientId == clientId;
      }
    }
    
    match /all_extinguishers/{id} {
      allow read, write: if isSignedIn();
    }

    match /service_orders/{id} {
      allow read, write: if isSignedIn();
    }
  }
}
